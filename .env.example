# EVE-MIRO local configuration
EVE_MIRO_ENV=dev
# Leave empty to use the in-memory event store (default for tests and first run).
DATABASE_URL=
# postgres://eve:eve@localhost:5432/eve_miro
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eve-miro
# When 1, stub providers report healthy and return recorded fixtures instead of live calls.
FIXTURES=1
# Optional live fetch. Tests never require the network.
OPENMETEO_LIVE=0
USGS_LIVE=0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

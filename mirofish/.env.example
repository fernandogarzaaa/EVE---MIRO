# LLM: OpenAI-compatible endpoint. This first run uses a local GGUF server.
# Dummy key 'local' is for the local server only — do not invent cloud keys.
LLM_API_KEY=local
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_MODEL_NAME=qwen2.5-0.5b-instruct

# ===== Zep Cloud graph memory =====
# Required unless local/dev bypass. This first run skips Zep (does NOT fake it).
ZEP_API_KEY=
MIROFISH_MEMORY=local
EVE_MIRO_ALLOW_LOCAL_MEMORY=1


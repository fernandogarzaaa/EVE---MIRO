# EVE-MIRO local configuration
EVE_MIRO_ENV=dev
# Leave empty to use the in-memory event store (default for tests and first run).
DATABASE_URL=
# postgres://eve:eve@localhost:5432/eve_miro
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eve-miro
# When 1, stub providers report healthy and return recorded fixtures instead of live calls.
FIXTURES=1
# Optional live fetch. Tests never require the network.
OPENMETEO_LIVE=0
USGS_LIVE=0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Fail closed: in-tree engines. Pytest conftest forces stub.
EVE_MIRO_ENGINES=in-tree
MIROFISH_URL=http://127.0.0.1:5001
MIROFISH_TIMEOUT_S=3600
MIROFISH_ROOT=./mirofish
EVE_ROOT=./eve
# EVE_BIN=./eve/bin/eve.js

# copy mirofish/.env.example → mirofish/.env
# Local OpenAI-compatible GGUF (llama.cpp / similar). Dummy key is 'local'.
# LLM_API_KEY=local
# LLM_BASE_URL=http://127.0.0.1:8088/v1
# LLM_MODEL_NAME=qwen2.5-0.5b-instruct
# Skip Zep Cloud for this first run (does not fake Zep):
# MIROFISH_MEMORY=local
# EVE_MIRO_ALLOW_LOCAL_MEMORY=1
